# CivicAI Environment Variables Template
# Copy this file to .env and replace placeholder values

APP_NAME=CivicAI
DEBUG=True
SECRET_KEY=replace_with_a_secure_random_key_in_production
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Database Configuration (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./civicai.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/civicai_db

# JWT Authentication
JWT_SECRET_KEY=replace_with_a_secure_jwt_secret_in_production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# File Storage & Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_EXTENSIONS=jpg,jpeg,png

# AI Model Inference
AI_MODEL_PATH=./ml/models/best.pt
AI_CONFIDENCE_THRESHOLD=0.5